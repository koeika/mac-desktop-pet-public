{
  "manifest_version": 3,
  "name": "PetPetKnows 生词收藏",
  "version": "0.4.16",
  "description": "从网页收藏单词与原句，发送到本机 PetPetKnows 桌宠复习。",
  "permissions": ["contextMenus", "storage", "alarms", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "icons": {"16": "icons/reading-cat-16.png", "32": "icons/reading-cat-32.png", "48": "icons/reading-cat-48.png", "128": "icons/reading-cat-128.png"},
  "action": {"default_title": "PetPetKnows · 生词收藏", "default_popup": "capture.html", "default_icon": {"16": "icons/reading-cat-16.png", "32": "icons/reading-cat-32.png", "48": "icons/reading-cat-48.png", "128": "icons/reading-cat-128.png"}},
  "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "run_at": "document_idle"}]
}
